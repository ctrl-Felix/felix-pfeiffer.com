{
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.production)",
      "Edit(./.env)",
      "Write(./.env)",
      "Bash(printenv*)",
      "Bash(env)",
      "Bash(git push origin main*)",
      "Bash(git push origin HEAD:main*)",
      "Bash(git push origin *:main*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push --delete origin staging*)",
      "Bash(git push --delete origin main*)",
      "Bash(git push origin --delete staging*)",
      "Bash(git push origin --delete main*)",
      "Bash(git push origin -d staging*)",
      "Bash(git push origin -d main*)",
      "Bash(git push origin :staging*)",
      "Bash(git checkout -b*)",
      "Bash(git switch -c*)",
      "Bash(git branch -d*)",
      "Bash(git branch -D*)",
      "Bash(git branch -m*)",
      "Bash(git branch -f*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/update-tokens.sh"
          }
        ]
      }
    ]
  }
}
